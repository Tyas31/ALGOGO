# Optional: use a DIFFERENT Firebase project by copying this file to .env.local.
# The shared ALGOGO project already works through the Git-tracked .env file.
# Uncomment and fill ALL six fields only when using your own Firebase project.
# Firebase Console > Project settings > Your apps > Web app configuration
# Public client identifiers only. Never put an Admin SDK private key here.
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
